{
  "name": "nodos-educativos",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run --config vitest.rules.config.ts",
    "check:rules": "node scripts/generate-rules.mjs --check",
    "generate:rules": "node scripts/generate-rules.mjs",
    "check": "npm run check:rules && npm run test && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^14.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
